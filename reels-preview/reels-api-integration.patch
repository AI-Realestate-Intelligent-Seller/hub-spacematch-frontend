+// Reels linked on a listing: the agent's card (paste links, see numbers, refresh) and
+// the seller's section (watch the Reel on the page, with views, likes, comments, shares).
+import { useMutation, useQuery } from "convex/react";
+import { ArrowUpRight, Eye, Heart, Loader2, MessageCircle, RefreshCw, Share2 } from "lucide-react";
+import { useEffect, useState } from "react";
+import { toast } from "sonner";
+import { api } from "../../../convex/_generated/api";
+import type { Doc } from "../../../convex/_generated/dataModel";
+import { REEL_LABEL, REEL_PLACEHOLDER, REEL_PLATFORMS, type ReelPlatform, parseReelFor } from "../../../convex/reelLinks";
+
+const ago = (t: number) => {
+  const m = Math.round((Date.now() - t) / 60000);
+  if (m < 1) return "just now";
+  if (m < 60) return `${m} min ago`;
+  const h = Math.round(m / 60);
+  if (h < 24) return `${h}h ago`;
+  const d = Math.round(h / 24);
+  return d < 14 ? `${d}d ago` : new Date(t).toLocaleDateString();
+};
+const asOf = (t: number) => new Date(t).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
+const mmss = (ms: number) => { const s = Math.max(0, Math.ceil(ms / 1000)); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`; };
+const errMsg = (e: unknown) => (e instanceof Error ? e.message.replace(/^.*Uncaught Error:\s*/s, "").split("\n")[0] : "Something went wrong");
+const num = (n?: number) => (n == null ? "N/A" : n.toLocaleString());
+// Seller rows are narrow on a phone: 1,810,096 becomes 1.8M there (full number in the tooltip and the totals).
+const short = (n: number) => (n >= 100_000 ? new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 }).format(n) : n.toLocaleString());
+const METRICS = [
+  ["views", "Views", Eye],
+  ["likes", "Likes", Heart],
+  ["comments", "Comments", MessageCircle],
+  ["shares", "Shares", Share2],
+] as const;
+type Counts = { views?: number; likes?: number; comments?: number; shares?: number };
+
+// ---------- Agent: Weekly numbers tab ----------
+
+export function ReelLinksCard({ l }: { l: Doc<"listings"> }) {
+  const data = useQuery(api.reelStats.forListing, { id: l._id });
+  const saveLinks = useMutation(api.reelStats.saveLinks);
+  const refresh = useMutation(api.reelStats.requestRefresh);
+  const [vals, setVals] = useState<Record<ReelPlatform, string>>({ instagram: "", facebook: "", tiktok: "", youtube: "" });
+  const [busy, setBusy] = useState(false);
+  const [now, setNow] = useState(Date.now());
+  const cooling = !!data?.cooldownUntil && data.cooldownUntil > now;
+  useEffect(() => {
+    if (!data?.cooldownUntil) return;
+    const t = setInterval(() => setNow(Date.now()), 1000);
+    return () => clearInterval(t);
+  }, [data?.cooldownUntil]);
+  const saved = data ? data.platforms.map(p => p.link).join("|") : null;
+  // biome-ignore lint/correctness/useExhaustiveDependencies: reload the boxes only when the saved links change
+  useEffect(() => {
+    if (data) setVals(Object.fromEntries(data.platforms.map(p => [p.platform, p.link])) as Record<ReelPlatform, string>);
+  }, [saved]);
+  if (!data) return <div className="rounded-2xl bg-white p-4 ring-1 ring-black/5"><Loader2 className="size-5 animate-spin text-stone-400" aria-label="Loading" /></div>;
+
+  const dirty = data.platforms.some(p => (vals[p.platform] ?? "").trim() !== p.link);
+  const anyLink = data.platforms.some(p => p.link);
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    for (const p of REEL_PLATFORMS) {
+      const raw = (vals[p] ?? "").trim();
+      if (!raw) continue;
+      try { parseReelFor(p, raw); } catch (err) { toast.error(`${REEL_LABEL[p]}: ${errMsg(err)}`); return; }
+    }
+    setBusy(true);
+    try {
+      const r = await saveLinks({ id: l._id, instagram: vals.instagram ?? "", facebook: vals.facebook ?? "", tiktok: vals.tiktok ?? "", youtube: vals.youtube ?? "" });
+      toast.success(r.changed ? "Saved. Reading the numbers now, usually 1-3 minutes." : "Saved");
+    } catch (err) { toast.error(errMsg(err)); } finally { setBusy(false); }
+  };
+  const doRefresh = async () => {
+    try { await refresh({ id: l._id }); toast.success("Refreshing. New numbers show here in 1-3 minutes."); } catch (err) { toast.error(errMsg(err)); }
+  };
+
+  return (
+    <form onSubmit={submit} className="rounded-2xl bg-white p-4 ring-1 ring-black/5" data-testid="reel-links">
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <div className="min-w-0">
+          <div className="font-semibold">Reels for this listing</div>
+          <p className="mt-0.5 text-[15px] text-stone-600">Paste this property's Reel link for each platform. Views, likes, comments and shares are updated every morning, when you save links and when you tap Refresh now. Your seller sees the Reels and the numbers.</p>
+        </div>
+        <button type="button" onClick={doRefresh} disabled={!anyLink || dirty || !!data.queued || cooling} title={cooling ? "Each listing can be refreshed once every 10 minutes" : undefined} data-testid="reel-refresh" className="inline-flex shrink-0 items-center gap-1.5 rounded-xl px-3 py-2 text-sm font-semibold ring-1 ring-stone-300 disabled:opacity-50">
+          <RefreshCw className={`size-4 ${data.queued ? "animate-spin" : ""}`} aria-hidden /> {data.queued ? "Refreshing…" : cooling ? `Refresh in ${mmss((data.cooldownUntil ?? 0) - now)}` : "Refresh now"}
+        </button>
+      </div>
+      {data.queued && <p className="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" data-testid="reel-queued">{data.queued.kind === "links" ? "Reading the new links" : "Refreshing the numbers"} now (started {ago(data.queued.requestedAt)}). This usually takes 1-3 minutes; the numbers update here by themselves.</p>}
+      {data.error && !data.error.platform && !data.queued && <p className="mt-2 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-testid="reel-api-error">{data.error.message}</p>}
+      <div className="mt-3 space-y-3">
+        {data.platforms.map(p => {
+          const s = p.stat;
+          const rowErr = !data.queued && data.error?.platform === p.platform ? data.error.message : null;
+          return (
+            <div key={p.platform} className="rounded-xl bg-stone-50 p-3" data-testid={`reel-row-${p.platform}`}>
+              <label className="block text-sm font-medium text-stone-700">{REEL_LABEL[p.platform]} link
+                <input className="mt-1 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-[15px] outline-none focus:border-[#9C7434]" aria-label={`${REEL_LABEL[p.platform]} Reel link`} inputMode="url" placeholder={REEL_PLACEHOLDER[p.platform]} value={vals[p.platform] ?? ""} onChange={e => setVals({ ...vals, [p.platform]: e.target.value })} />
+              </label>
+              {rowErr && <p className="mt-1.5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-testid={`reel-${p.platform}-api-error`}>{rowErr}</p>}
+              {p.link && (
+                <div className="mt-2">
+                  {s?.okAt ? (
+                    <>
+                      <dl className="grid grid-cols-4 gap-2 text-center">
+                        {METRICS.map(([k, label]) => (
+                          <div key={k} className="rounded-lg bg-white py-1.5 ring-1 ring-stone-200">
+                            <dd className={`font-display text-xl ${s[k] == null ? "text-stone-400" : ""}`} data-testid={`reel-${p.platform}-${k}`}>{num(s[k])}</dd>
+                            <dt className="text-xs text-stone-500">{label}</dt>
+                          </div>
+                        ))}
+                      </dl>
+                      <p className="mt-1.5 text-xs text-stone-500">As of {asOf(s.okAt)}{s.detail ? ` · ${s.detail}` : ""}</p>
+                    </>
+                  ) : !s?.error ? (
+                    <p className="text-sm text-stone-500">{data.queued ? "Fetching…" : "Waiting for the first read."}</p>
+                  ) : null}
+                  {s?.error && <p className="mt-1.5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800" data-testid={`reel-${p.platform}-error`}>{s.okAt ? `Couldn't update ${ago(s.checkedAt)}, showing the last known numbers. ` : `Couldn't read this Reel ${ago(s.checkedAt)}. `}{s.error}</p>}
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+      <div className="mt-3 flex flex-wrap items-center gap-3">
+        <button disabled={busy || !dirty} className="rounded-xl bg-[#0A0A0A] px-6 py-2.5 font-semibold text-white disabled:opacity-40">Save Reel links</button>
+        <span className="text-sm text-stone-500">N/A means the platform doesn't show that number publicly.</span>
+      </div>
+    </form>
+  );
+}
+
+// ---------- Seller: private page ----------
+
+export type SellerReel = Counts & { platform: ReelPlatform; url: string; embedUrl?: string; checkedAt?: number };
+
+export function SellerReels({ reels }: { reels: SellerReel[] }) {
+  const [sel, setSel] = useState<ReelPlatform | null>(null);
+  if (!reels.length) return null;
+  const cur = reels.find(r => r.platform === sel) ?? reels.find(r => r.embedUrl) ?? reels[0];
+  const total = (k: keyof Counts) => (reels.some(r => r[k] != null) ? reels.reduce((a, r) => a + (r[k] ?? 0), 0) : undefined);
+  const checked = Math.max(0, ...reels.map(r => r.checkedAt ?? 0));
+  return (
+    <section className="rounded-2xl bg-white p-5 ring-1 ring-black/5" data-testid="seller-reels">
+      <div className="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
+        <h2 className="font-display text-xl">Your Reel across social</h2>
+        {checked > 0 && <span className="text-sm text-stone-500">Updated {ago(checked)}</span>}
+      </div>
+
+      <dl className="mt-4 grid grid-cols-2 gap-2 text-center sm:grid-cols-4" data-testid="seller-reels-totals">
+        {METRICS.map(([k, label, Icon]) => (
