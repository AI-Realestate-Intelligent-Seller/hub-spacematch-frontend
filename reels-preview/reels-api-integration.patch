diff --git a/convex/reelLinks.ts b/convex/reelLinks.ts
new file mode 100644
index 0000000..a1f4d64
--- /dev/null
+++ b/convex/reelLinks.ts
@@ -0,0 +1,126 @@
+// Allowlisted Reel links (Instagram, Facebook, TikTok, YouTube). Pure code shared by
+// the Hub backend, the agent form and the seller page. Nothing here fetches a URL:
+// a link is only ever parsed, canonicalised and turned into an embed address on one
+// of the four known hosts. Port of urls.py from the Reels MVP (v0.4).
+
+export const REEL_PLATFORMS = ["instagram", "facebook", "tiktok", "youtube"] as const;
+export type ReelPlatform = (typeof REEL_PLATFORMS)[number];
+
+/** Where each platform's link lives on listings.links (existing fields). */
+export const REEL_LINK_KEY = { instagram: "reel", facebook: "facebook", tiktok: "tiktok", youtube: "youtube" } as const;
+export const REEL_LABEL: Record<ReelPlatform, string> = { instagram: "Instagram", facebook: "Facebook", tiktok: "TikTok", youtube: "YouTube" };
+export const REEL_PLACEHOLDER: Record<ReelPlatform, string> = {
+  instagram: "https://www.instagram.com/reel/…",
+  facebook: "https://www.facebook.com/reel/… or /share/r/…",
+  tiktok: "https://www.tiktok.com/@name/video/… or vt.tiktok.com/…",
+  youtube: "https://www.youtube.com/shorts/…",
+};
+/** listingMetrics field + "auto" tag each platform's view count is mirrored into. */
+export const REEL_METRIC = {
+  instagram: { field: "reelViews", auto: "reel" },
+  facebook: { field: "fbViews", auto: "facebook" },
+  tiktok: { field: "tiktokViews", auto: "tiktok" },
+  youtube: { field: "youtubeViews", auto: "youtube" },
+} as const;
+
+export type ParsedReel = { platform: ReelPlatform; key: string; url: string; embedUrl?: string };
+
+export class InvalidReelUrl extends Error {}
+
+const fbEmbed = (canonical: string) => `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(canonical)}&show_text=false`;
+
+export function parseReelUrl(value: string): ParsedReel {
+  const raw = (value ?? "").trim();
+  if (!raw || raw.length > 2048) throw new InvalidReelUrl("Paste a Reel link from Instagram, Facebook, TikTok or YouTube");
+  let u: URL;
+  try {
+    u = new URL(raw);
+  } catch {
+    throw new InvalidReelUrl("That doesn't look like a link. It should start with https://");
+  }
+  if (u.protocol !== "https:" || u.port || u.username || u.password) throw new InvalidReelUrl("Reel links must start with https://");
+  const host = u.hostname.toLowerCase();
+  const path = u.pathname.replace(/\/+$/, "");
+
+  if (host === "instagram.com" || host === "www.instagram.com") {
+    const m = path.match(/^(?:\/[\w.]{1,30})?\/(?:reel|reels|p)\/([\w-]{3,64})$/);
+    if (!m) throw new InvalidReelUrl("Use the Reel's own link (instagram.com/reel/…)");
+    return { platform: "instagram", key: m[1], url: `https://www.instagram.com/reel/${m[1]}/`, embedUrl: `https://www.instagram.com/reel/${m[1]}/embed/` };
+  }
+
+  if (host === "facebook.com" || host === "www.facebook.com" || host === "m.facebook.com") {
+    const m = path.match(/^\/reel\/(\d{3,32})$/) ?? path.match(/^\/[^/]+\/(?:reels|videos)\/(\d{3,32})$/);
+    if (m) {
+      const url = `https://www.facebook.com/reel/${m[1]}`;
+      return { platform: "facebook", key: m[1], url, embedUrl: fbEmbed(url) };
+    }
+    if (path === "/watch") {
+      const vid = u.searchParams.get("v") ?? "";
+      if (/^\d{3,32}$/.test(vid)) {
+        const url = `https://www.facebook.com/watch/?v=${vid}`;
+        return { platform: "facebook", key: vid, url, embedUrl: fbEmbed(url) };
+      }
+    }
+    // Share buttons return opaque short links; the worker resolves them to the video id.
+    const s = path.match(/^\/share\/(r|v)\/([\w-]{3,64})$/);
+    if (s) return { platform: "facebook", key: `share:${s[2]}`, url: `https://www.facebook.com/share/${s[1]}/${s[2]}/` };
+    throw new InvalidReelUrl("Use a Facebook Reel or video link (facebook.com/reel/… or /share/r/…)");
+  }
+  if (host === "fb.watch") {
+    const m = path.match(/^\/([\w-]{3,64})$/);
+    if (m) return { platform: "facebook", key: `watch:${m[1]}`, url: `https://fb.watch/${m[1]}/` };
+    throw new InvalidReelUrl("Use a Facebook Reel or video link");
+  }
+
+  if (host === "youtube.com" || host === "www.youtube.com" || host === "m.youtube.com" || host === "youtu.be") {
+    let vid: string | undefined;
+    if (host === "youtu.be") vid = path.match(/^\/([\w-]{11})$/)?.[1];
+    else {
+      vid = path.match(/^\/(?:shorts|live|embed)\/([\w-]{11})$/)?.[1];
+      if (!vid && path === "/watch") {
+        const q = u.searchParams.get("v") ?? "";
+        if (/^[\w-]{11}$/.test(q)) vid = q;
+      }
+    }
+    if (!vid) throw new InvalidReelUrl("Use a YouTube Shorts or video link (youtube.com/shorts/…)");
+    return { platform: "youtube", key: vid, url: `https://www.youtube.com/shorts/${vid}`, embedUrl: `https://www.youtube.com/embed/${vid}` };
+  }
+
+  if (host === "tiktok.com" || host === "www.tiktok.com" || host === "m.tiktok.com" || host === "vt.tiktok.com" || host === "vm.tiktok.com") {
+    const m = path.match(/^\/@([\w.-]{1,40})\/video\/(\d{8,25})$/);
+    if (m) return { platform: "tiktok", key: m[2], url: `https://www.tiktok.com/@${m[1]}/video/${m[2]}`, embedUrl: `https://www.tiktok.com/embed/v2/${m[2]}` };
+    // Share short links redirect to the video; the worker reports the real id.
+    const short = host === "vt.tiktok.com" || host === "vm.tiktok.com";
+    const s = short ? path.match(/^\/([\w-]{5,20})$/) : path.match(/^\/t\/([\w-]{5,20})$/);
+    if (s) return { platform: "tiktok", key: `share:${s[1]}`, url: short ? `https://${host}/${s[1]}/` : `https://www.tiktok.com/t/${s[1]}/` };
+    throw new InvalidReelUrl("Use a TikTok video link (tiktok.com/@name/video/…) or its share link");
+  }
+
+  throw new InvalidReelUrl("Only Instagram, Facebook, TikTok and YouTube links work here");
+}
+
+/** Parse a link pasted into one platform's box; it must belong to that platform. */
+export function parseReelFor(platform: ReelPlatform, value: string): ParsedReel {
+  const p = parseReelUrl(value);
+  if (p.platform !== platform) throw new InvalidReelUrl(`That is a ${REEL_LABEL[p.platform]} link. Paste it in the ${REEL_LABEL[p.platform]} box.`);
+  return p;
+}
+
+/** Same Reel? Compares canonical forms, so tracking params and trailing slashes don't matter. */
+export function sameReel(a?: string, b?: string): boolean {
+  if (!a || !b) return false;
+  if (a === b) return true;
+  try {
+    const pa = parseReelUrl(a);
+    const pb = parseReelUrl(b);
+    return pa.platform === pb.platform && pa.key === pb.key;
+  } catch {
+    return false;
+  }
+}
+
+/** Embed address the seller page may put in an iframe: only the four known players. */
+export function safeEmbedUrl(u?: string): string | undefined {
+  if (!u) return undefined;
+  return /^https:\/\/(www\.instagram\.com\/reel\/[\w-]+\/embed\/|www\.facebook\.com\/plugins\/video\.php\?href=https%3A%2F%2F(www\.facebook\.com|fb\.watch)%2F[\w%.=-]+(&show_text=false)?|www\.youtube\.com\/embed\/[\w-]{11}|www\.tiktok\.com\/embed\/v2\/\d{8,25})$/.test(u) ? u : undefined;
+}
diff --git a/convex/reelStats.ts b/convex/reelStats.ts
new file mode 100644
index 0000000..4500ed8
--- /dev/null
+++ b/convex/reelStats.ts
@@ -0,0 +1,135 @@
+// Reel analytics from pasted links (Instagram, Facebook, TikTok, YouTube).
+//
+// The agent pastes one Reel link per platform on the listing. The Hub never opens those
+// pages itself: the SpaceMatch Reels API reads the public counters (convex/reelsApi.ts runs
+// the calls in the background and saves the numbers into reelStats). The agent card and the
+// seller page read only reelStats.
+import { v } from "convex/values";
+import type { Doc, Id } from "./_generated/dataModel";
+import type { MutationCtx, QueryCtx } from "./_generated/server";
+import { authenticatedMutation, authenticatedQuery } from "./functions";
+import { mine } from "./listings";
+import { InvalidReelUrl, REEL_LABEL, REEL_LINK_KEY, REEL_PLATFORMS, type ReelPlatform, parseReelFor, parseReelUrl, safeEmbedUrl, sameReel } from "./reelLinks";
+import { JOB_STALE_MS, startJob } from "./reelsApi";
+
+const linkOf = (l: Pick<Doc<"listings">, "links">, p: ReelPlatform) => l.links?.[REEL_LINK_KEY[p]];
+
+async function statRows(ctx: QueryCtx, listingId: Id<"listings">) {
+  return await ctx.db.query("reelStats").withIndex("by_listing", q => q.eq("listingId", listingId)).collect();
+}
+
+/**
+ * Call after listings.links changed (any mutation). Numbers that belong to a link that
+ * was removed or swapped are dropped, and the listing is queued for a fresh read.
+ */
+export async function reelLinksChanged(ctx: MutationCtx, listingId: Id<"listings">, before: Doc<"listings">["links"], after: Doc<"listings">["links"]) {
+  let changed = false;
+  const rows = await statRows(ctx, listingId);
+  for (const p of REEL_PLATFORMS) {
+    const a = before?.[REEL_LINK_KEY[p]];
+    const b = after?.[REEL_LINK_KEY[p]];
+    if ((a ?? "") === (b ?? "") || sameReel(a, b)) continue;
+    changed = true;
+    for (const r of rows) if (r.platform === p) await ctx.db.delete(r._id);
+  }
+  // New/changed links → create or update the Reels property; all removed → archive it.
+  if (changed) await startJob(ctx, listingId, "links", "link");
+  return changed;
+}
+
+// ---------- Agent side ----------
+
+export const forListing = authenticatedQuery({
+  args: { id: v.id("listings") },
+  handler: async (ctx, { id }) => {
+    const { l } = await mine(ctx, ctx.userId, id);
+    const rows = await statRows(ctx, id);
+    const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", id)).first();
+    const job = s?.job && Date.now() - s.job.since < JOB_STALE_MS ? s.job : null;
+    return {
+      platforms: REEL_PLATFORMS.map(p => {
+        const link = linkOf(l, p) ?? "";
+        const r = rows.find(x => x.platform === p && sameReel(x.url, link));
+        return {
+          platform: p,
+          link,
+          stat: r ? { views: r.views, likes: r.likes, comments: r.comments, shares: r.shares, checkedAt: r.checkedAt, okAt: r.okAt, error: r.error, detail: r.detail } : null,
+        };
+      }),
+      queued: job ? { requestedAt: job.since, by: job.by, kind: job.kind } : null,
+      error: s?.error ?? null,
+      cooldownUntil: s?.cooldownUntil && s.cooldownUntil > Date.now() ? s.cooldownUntil : null,
+      lastRefreshStatus: s?.lastRefreshStatus ?? null,
+    };
+  },
+});
+
+export const saveLinks = authenticatedMutation({
+  args: { id: v.id("listings"), instagram: v.string(), facebook: v.string(), tiktok: v.string(), youtube: v.string() },
+  handler: async (ctx, { id, ...input }) => {
+    const { l } = await mine(ctx, ctx.userId, id);
+    const links = { ...(l.links ?? {}) };
+    for (const p of REEL_PLATFORMS) {
+      const raw = input[p].trim();
+      if (!raw) {
+        links[REEL_LINK_KEY[p]] = undefined;
+        continue;
+      }
+      try {
+        links[REEL_LINK_KEY[p]] = parseReelFor(p, raw).url;
+      } catch (e) {
+        throw new Error(e instanceof InvalidReelUrl ? e.message : "That link didn't work");
+      }
+    }
+    // One video per listing (the Reels service refuses the same video on two properties).
+    const others = (await ctx.db.query("listings").collect()).filter(o => o._id !== id);
+    for (const p of REEL_PLATFORMS) {
+      const mineLink = links[REEL_LINK_KEY[p]];
+      if (!mineLink || sameReel(mineLink, linkOf(l, p))) continue;
+      const dup = others.find(o => REEL_PLATFORMS.some(q => sameReel(mineLink, linkOf(o, q))));
+      if (dup) throw new Error(`${REEL_LABEL[p]}: this video is already linked to ${dup.address}. Remove it there first.`);
+    }
+    await ctx.db.patch(id, { links, updatedAt: Date.now() });
+    const changed = await reelLinksChanged(ctx, id, l.links, links);
+    return { changed };
+  },
+});
+
+export const requestRefresh = authenticatedMutation({
+  args: { id: v.id("listings") },
+  handler: async (ctx, { id }) => {
+    const { me, l } = await mine(ctx, ctx.userId, id);
+    if (!REEL_PLATFORMS.some(p => linkOf(l, p))) throw new Error("Add a Reel link first");
+    const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", id)).first();
+    if (s?.cooldownUntil && s.cooldownUntil > Date.now()) throw new Error(`Refreshed a few minutes ago. Try again in ${Math.ceil((s.cooldownUntil - Date.now()) / 60000)} min.`);
+    return { requestedAt: await startJob(ctx, id, "refresh", me.email) };
+  },
+});
+
+// ---------- Seller side (called from listings.portal) ----------
+
+export async function publicReels(ctx: QueryCtx, l: Doc<"listings">) {
+  const rows = await statRows(ctx, l._id);
+  return REEL_PLATFORMS.flatMap(p => {
+    const link = linkOf(l, p);
+    if (!link) return [];
+    let parsed: ReturnType<typeof parseReelUrl> | null = null;
+    try {
+      parsed = parseReelUrl(link);
+    } catch {
+      return []; // an old free-form link that is not a Reel: nothing to embed or count
+    }
+    if (parsed.platform !== p) return [];
+    const r = rows.find(x => x.platform === p && sameReel(x.url, link));
+    return [{
+      platform: p,
+      url: parsed.url,
+      embedUrl: safeEmbedUrl(r?.embedUrl) ?? safeEmbedUrl(parsed.embedUrl),
+      views: r?.views,
+      likes: r?.likes,
+      comments: r?.comments,
+      shares: r?.shares,
+      checkedAt: r?.okAt,
+    }];
+  });
+}
diff --git a/convex/reelsApi.ts b/convex/reelsApi.ts
new file mode 100644
index 0000000..fefbadd
--- /dev/null
+++ b/convex/reelsApi.ts
@@ -0,0 +1,461 @@
+// Reel numbers from the SpaceMatch Reels API (Haseeb's service, contract HUB_INTEGRATION.md 2026-11-23).
+//
+// The Hub keeps one Reels "property" per listing (table reelsApi) with the listing's Reel links
+// (one per platform, stored on listings.links as before). The API reads the public counters
+// inside the request, so every call that reads links runs here, in a scheduled background
+// action with a 300 s timeout; the agent's card shows "Reading…" meanwhile. Results land in
+// reelStats (agent card + seller page read only that table, never the API).
+//
+// Env (server only, never sent to the browser): REELS_API_URL (…/v1), REELS_API_KEY.
+import { v } from "convex/values";
+import { internal } from "./_generated/api";
+import type { Doc, Id } from "./_generated/dataModel";
+import { type ActionCtx, internalAction, internalMutation, internalQuery, type MutationCtx } from "./_generated/server";
+import { weekOf } from "./launchSteps";
+import { REEL_LINK_KEY, REEL_METRIC, REEL_PLATFORMS, type ReelPlatform, parseReelUrl, safeEmbedUrl, sameReel } from "./reelLinks";
+
+export const LIVE = ["Preparing", "Coming soon", "Active", "Under contract"];
+/** A job older than this is treated as dead (a Convex action stops at 10 minutes). */
+export const JOB_STALE_MS = 11 * 60_000;
+const LONG = 300_000;
+const SHORT = 15_000;
+
+const isPlatform = (p: string): p is ReelPlatform => (REEL_PLATFORMS as readonly string[]).includes(p);
+const linkOf = (l: Pick<Doc<"listings">, "links">, p: ReelPlatform) => l.links?.[REEL_LINK_KEY[p]];
+const isReelFor = (p: ReelPlatform, url?: string) => {
+  if (!url) return false;
+  try {
+    return parseReelUrl(url).platform === p;
+  } catch {
+    return false;
+  }
+};
+
+// ---------- HTTP client ----------
+
+export class ReelsApiError extends Error {
+  status: number;
+  code: string;
+  field: string | null;
+  requestId: string | null;
+  retryAfter: number | null;
+  constructor(status: number, code: string, message: string, field: string | null = null, requestId: string | null = null, retryAfter: number | null = null) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.field = field;
+    this.requestId = requestId;
+    this.retryAfter = retryAfter;
+  }
+}
+
+type CallOpts = { body?: unknown; idemKey?: string; timeoutMs?: number; query?: Record<string, string> };
+
+async function call<T>(method: string, path: string, o: CallOpts = {}): Promise<{ status: number; data: T }> {
+  const base = (process.env.REELS_API_URL ?? "").replace(/\/+$/, "");
+  const key = process.env.REELS_API_KEY ?? "";
+  if (!base || !key) throw new ReelsApiError(0, "not_configured", "The Reels service isn't set up on this Hub yet (REELS_API_URL / REELS_API_KEY).");
+  const qs = o.query ? `?${new URLSearchParams(o.query).toString()}` : "";
+  const requestId = `hub_${crypto.randomUUID().replace(/-/g, "").slice(0, 20)}`;
+  let last: ReelsApiError | null = null;
+  for (let attempt = 1; attempt <= 3; attempt++) {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), o.timeoutMs ?? SHORT);
+    let res: Response;
+    try {
+      res = await fetch(`${base}${path}${qs}`, {
+        method,
+        headers: {
+          Authorization: `Bearer ${key}`,
+          Accept: "application/json",
+          "X-Request-Id": requestId,
+          ...(o.body !== undefined ? { "Content-Type": "application/json" } : {}),
+          ...(o.idemKey ? { "Idempotency-Key": o.idemKey } : {}),
+        },
+        body: o.body !== undefined ? JSON.stringify(o.body) : undefined,
+        signal: ctrl.signal,
+      });
+    } catch (e) {
+      clearTimeout(timer);
+      const timedOut = e instanceof Error && e.name === "AbortError";
+      last = new ReelsApiError(0, timedOut ? "timeout" : "network", timedOut ? "The Reels service took too long to answer" : "Couldn't reach the Reels service", null, requestId);
+      if (attempt < 3) await new Promise(r => setTimeout(r, 2000 * attempt));
+      continue;
+    }
+    clearTimeout(timer);
+    if (res.status === 204) return { status: 204, data: null as T };
+    const text = await res.text();
+    let json: any = null;
+    try {
+      json = text ? JSON.parse(text) : null;
+    } catch {
+      json = null;
+    }
+    if (res.ok) return { status: res.status, data: json as T };
+    const err = json?.error ?? {};
+    const retryAfter = Number(res.headers.get("retry-after")) || null;
+    last = new ReelsApiError(res.status, err.code ?? `http_${res.status}`, err.message ?? `Reels service error (HTTP ${res.status})`, err.field ?? null, res.headers.get("x-request-id") ?? requestId, retryAfter);
+    // Retry only network errors and 5xx. 429 here is the per-property refresh cooldown: tell the agent instead.
+    if (res.status < 500) break;
+    if (attempt < 3) await new Promise(r => setTimeout(r, 2000 * attempt));
+  }
+  if (last?.status === 401) console.error("REELS API 401: REELS_API_KEY missing, revoked or wrong", JSON.stringify({ requestId: last.requestId }));
+  else console.warn("reels api error", JSON.stringify({ method, path, status: last?.status, code: last?.code, requestId: last?.requestId }));
+  throw last ?? new ReelsApiError(0, "unknown", "Reels service error");
+}
+
+type ApiRefresh = { id: string; status: string; links?: { platform: string; status: string }[] };
+type ApiReel = {
+  link_id: string; platform: string; url: string; canonical_url?: string; embed_url?: string | null;
+  views: number | null; likes: number | null; comments: number | null; shares: number | null;
+  checked_at: string | null; ok_at: string | null; source?: string | null; source_detail?: string | null;
+  error: { code: string; message: string } | null;
+};
+type ApiAnalytics = { property_id: string; reels: ApiReel[]; last_refresh?: unknown };
+
+const FINAL = ["done", "partial", "failed", "cancelled"];
+
+/** A refresh came back `running` (the request hit its time budget): each GET reads more links. Max 3 calls. */
+async function finishRefresh(r: ApiRefresh | null | undefined) {
+  let cur = r;
+  for (let i = 0; cur && !FINAL.includes(cur.status) && i < 3; i++) {
+    cur = (await call<ApiRefresh>("GET", `/refreshes/${cur.id}`, { timeoutMs: LONG })).data;
+  }
+  return cur ?? null;
+}
+
+// ---------- State (one row per listing) ----------
+
+type LoadResult = {
+  listing: { address: string; status: string; links: { platform: ReelPlatform; url: string }[] } | null;
+  state: Doc<"reelsApi"> | null;
+};
+type SyncStateResult = {
+  lastSyncAt: number | null;
+  states: { listingId: Id<"listings">; propertyId: string | null; archived: boolean; address: string | null; listing: { address: string; live: boolean; hasLinks: boolean } | null }[];
+  missing: Id<"listings">[];
+};
+
+export const load = internalQuery({
+  args: { listingId: v.id("listings") },
+  handler: async (ctx, { listingId }): Promise<LoadResult> => {
+    const l = await ctx.db.get(listingId);
+    const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", listingId)).first();
+    if (!l) return { listing: null, state: s };
+    const links = REEL_PLATFORMS.flatMap(p => {
+      const url = linkOf(l, p);
+      if (!url) return [];
+      try {
+        const parsed = parseReelUrl(url);
+        return parsed.platform === p ? [{ platform: p, url: parsed.url }] : [];
+      } catch {
+        return []; // old free-form text that isn't a Reel link: never sent
+      }
+    });
+    return { listing: { address: l.address, status: l.status, links }, state: s };
+  },
+});
+
+export const patchState = internalMutation({
+  args: {
+    listingId: v.id("listings"),
+    set: v.object({
+      propertyId: v.optional(v.string()),
+      address: v.optional(v.string()),
+      archived: v.optional(v.boolean()),
+      createKey: v.optional(v.union(v.string(), v.null())),
+      error: v.optional(v.union(v.object({ message: v.string(), platform: v.optional(v.string()), code: v.optional(v.string()) }), v.null())),
+      cooldownUntil: v.optional(v.union(v.number(), v.null())),
+      lastRefreshId: v.optional(v.string()),
+      lastRefreshStatus: v.optional(v.string()),
+      syncedAt: v.optional(v.number()),
+    }),
+    finishToken: v.optional(v.string()),
+  },
+  handler: async (ctx, { listingId, set, finishToken }) => {
+    const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", listingId)).first();
+    const patch: Record<string, unknown> = { updatedAt: Date.now() };
+    for (const [k, val] of Object.entries(set)) if (val !== undefined) patch[k] = val === null ? undefined : val;
+    if (finishToken && s?.job?.token === finishToken) patch.job = undefined;
+    if (s) await ctx.db.patch(s._id, patch);
+    else await ctx.db.insert("reelsApi", { listingId, ...(patch as { updatedAt: number }) });
+    return null;
+  },
+});
+
+/**
+ * Start a background job for a listing: "links" after the links changed, "refresh" for
+ * Refresh now. One job at a time per listing; a new "links" job replaces the token so the
+ * older run's finish doesn't clear the newer one's "Reading…" state.
+ */
+export async function startJob(ctx: MutationCtx, listingId: Id<"listings">, kind: "links" | "refresh", by: string) {
+  const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", listingId)).first();
+  const now = Date.now();
+  const running = s?.job && now - s.job.since < JOB_STALE_MS ? s.job : null;
+  if (running && kind === "refresh") return running.since;
+  const token = crypto.randomUUID();
+  const job = { kind, by, since: now, token };
+  const createKey = s?.propertyId ? s.createKey : (s?.createKey ?? crypto.randomUUID());
+  if (s) await ctx.db.patch(s._id, { job, createKey, error: kind === "links" ? undefined : s.error, updatedAt: now });
+  else await ctx.db.insert("reelsApi", { listingId, job, createKey, updatedAt: now });
+  await ctx.scheduler.runAfter(0, internal.reelsApi.run, { listingId, kind, by, token, idemKey: crypto.randomUUID() });
+  return now;
+}
+
+// ---------- The job ----------
+
+export const run = internalAction({
+  args: { listingId: v.id("listings"), kind: v.union(v.literal("links"), v.literal("refresh")), by: v.string(), token: v.string(), idemKey: v.string() },
+  handler: async (ctx, a): Promise<Record<string, unknown>> => {
+    let out: Record<string, unknown> = {};
+    const started = Date.now();
+    try {
+      out = await runJob(ctx, a);
+      // The service allows one manual refresh per property every 10 minutes: show the countdown right away.
+      const cooldown = a.kind === "refresh" ? { cooldownUntil: started + 600_000 } : {};
+      await ctx.runMutation(internal.reelsApi.patchState, { listingId: a.listingId, set: { error: null, ...cooldown }, finishToken: a.token });
+    } catch (e) {
+      const err = e instanceof ReelsApiError ? e : new ReelsApiError(0, "internal", e instanceof Error ? e.message : "Something went wrong");
+      const { listing }: LoadResult = await ctx.runQuery(internal.reelsApi.load, { listingId: a.listingId });
+      const idx = err.field?.match(/^links\[(\d+)\]$/)?.[1];
+      const platform = idx !== undefined ? listing?.links[Number(idx)]?.platform : undefined;
+      const message = err.status === 429
+        ? `Refreshed a few minutes ago. You can refresh again in ${Math.max(1, Math.ceil((err.retryAfter ?? 600) / 60))} min.`
+        : err.status === 401 ? "The Reels service rejected the Hub's key. Ops has been alerted." : err.message;
+      await ctx.runMutation(internal.reelsApi.patchState, {
+        listingId: a.listingId,
+        set: { error: { message: message.slice(0, 300), platform, code: err.code }, ...(err.status === 429 ? { cooldownUntil: Date.now() + (err.retryAfter ?? 600) * 1000 } : {}) },
+        finishToken: a.token,
+      });
+      out = { error: err.code, status: err.status, requestId: err.requestId };
+    }
+    console.log("reels api job", JSON.stringify({ listingId: a.listingId, kind: a.kind, ...out }));
+    return out;
+  },
+});
+
+async function runJob(ctx: ActionCtx, a: { listingId: Id<"listings">; kind: "links" | "refresh"; by: string; idemKey: string }): Promise<Record<string, unknown>> {
+  const { listing, state }: LoadResult = await ctx.runQuery(internal.reelsApi.load, { listingId: a.listingId });
+  if (!listing) return { skipped: "listing gone" };
+  const urls = listing.links.map(x => x.url);
+  let propertyId = state?.propertyId;
+  const set = (s: Record<string, unknown>) => patch(ctx, a.listingId, s);
+
+  // No links left: archive (keeps history; re-adding a link unarchives).
+  if (!urls.length) {
+    if (propertyId && !state?.archived) {
+      await call("POST", `/properties/${propertyId}/archive`);
+      await set({ archived: true });
+    }
+    return { archived: !!propertyId };
+  }
+
+  let refresh: ApiRefresh | null = null;
+  if (!propertyId) {
+    const r = await call<{ id: string; refresh: ApiRefresh | null }>("POST", "/properties", { body: { address: listing.address, links: urls }, idemKey: state?.createKey ?? a.idemKey, timeoutMs: LONG });
+    propertyId = r.data.id;
+    await set({ propertyId, address: listing.address, archived: false, createKey: null });
+    refresh = r.data.refresh;
+  } else {
+    if (state?.archived) {
+      await call("POST", `/properties/${propertyId}/unarchive`);
+      await set({ archived: false });
+    }
+    if (state?.address !== listing.address) {
+      await call("PATCH", `/properties/${propertyId}`, { body: { address: listing.address } });
+      await set({ address: listing.address });
+    }
+    if (a.kind === "links") {
+      const r = await call<{ refresh: ApiRefresh | null }>("PUT", `/properties/${propertyId}/links`, { body: { links: urls }, timeoutMs: LONG });
+      refresh = r.data.refresh;
+    } else {
+      const r = await call<{ refresh: ApiRefresh }>("POST", `/properties/${propertyId}/refresh`, { body: { requested_by: a.by }, idemKey: a.idemKey, timeoutMs: LONG });
+      refresh = r.data.refresh;
+    }
+  }
+  const fin = await finishRefresh(refresh);
+  if (fin) await set({ lastRefreshId: fin.id, lastRefreshStatus: fin.status });
+  const an = (await call<ApiAnalytics>("GET", `/properties/${propertyId}/analytics`)).data;
+  const saved: { saved: number } = await ctx.runMutation(internal.reelsApi.applyAnalytics, { listingId: a.listingId, reels: an.reels });
+  return { propertyId, refresh: fin?.status ?? null, ...saved };
+}
+
+const patch = (ctx: ActionCtx, listingId: Id<"listings">, set: Record<string, unknown>) =>
+  ctx.runMutation(internal.reelsApi.patchState, { listingId, set: set as never });
+
+// ---------- Saving numbers (reelStats is what the agent card and seller page read) ----------
+
+const FRIENDLY_ERROR: Record<string, string> = {
+  upstream_blocked: "The platform didn't show the numbers this time.",
+  not_found: "This video is no longer available. Please replace the link.",
+  invalid_link: "This video is no longer available. Please replace the link.",
+};
+
+export const applyAnalytics = internalMutation({
+  args: { listingId: v.id("listings"), reels: v.array(v.any()) },
+  handler: async (ctx, { listingId, reels }): Promise<{ saved: number }> => {
+    const l = await ctx.db.get(listingId);
+    if (!l) return { saved: 0 };
+    const now = Date.now();
+    const rows = await ctx.db.query("reelStats").withIndex("by_listing", q => q.eq("listingId", listingId)).collect();
+    let saved = 0;
+    for (const raw of reels) {
+      const r = raw as ApiReel;
+      if (!isPlatform(r.platform)) continue;
+      const link = linkOf(l, r.platform);
+      // Only numbers for the link the listing has now (the agent may have swapped it meanwhile).
+      if (!link || !(sameReel(link, r.url) || sameReel(link, r.canonical_url))) continue;
+      let parsed: ReturnType<typeof parseReelUrl>;
+      try {
+        parsed = parseReelUrl(link);
+      } catch {
+        continue;
+      }
+      const okAt = r.ok_at ? Date.parse(r.ok_at) : undefined;
+      const checkedAt = r.checked_at ? Date.parse(r.checked_at) : (okAt ?? now);
+      const n = (x: number | null) => (typeof x === "number" && Number.isFinite(x) && x >= 0 ? Math.round(x) : undefined);
+      const nums = { views: n(r.views), likes: n(r.likes), comments: n(r.comments), shares: n(r.shares) };
+      const cur = rows.find(x => x.platform === r.platform);
+      const row = {
+        listingId, platform: r.platform, url: parsed.url, key: parsed.key,
+        embedUrl: safeEmbedUrl(r.embed_url ?? undefined) ?? safeEmbedUrl(parsed.embedUrl) ?? cur?.embedUrl,
+        ...(okAt ? nums : {}),
+        detail: r.source_detail?.slice(0, 300) ?? undefined,
+        error: r.error ? (FRIENDLY_ERROR[r.error.code] ?? "Couldn't update just now.") : undefined,
+        checkedAt, okAt,
+      };
+      if (cur) await ctx.db.replace(cur._id, row);
+      else await ctx.db.insert("reelStats", row);
+      saved++;
+      // A new successful read: keep history and mirror views into this week's numbers.
+      if (okAt && okAt !== cur?.okAt) {
+        await ctx.db.insert("reelSnapshots", { listingId, platform: r.platform, url: parsed.url, ...nums, at: okAt });
+        if (nums.views !== undefined) {
+          const { field, auto: tag } = REEL_METRIC[r.platform];
+          const wk = weekOf(okAt);
+          const m = await ctx.db.query("listingMetrics").withIndex("by_listing_week", q => q.eq("listingId", listingId).eq("weekOf", wk)).first();
+          const auto = Array.from(new Set([...(m?.auto ?? []), tag]));
+          if (m) await ctx.db.patch(m._id, { [field]: nums.views, auto, updatedAt: now });
+          else await ctx.db.insert("listingMetrics", { listingId, weekOf: wk, [field]: nums.views, auto, enteredByEmail: "auto", updatedAt: now });
+        }
+      }
+    }
+    const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", listingId)).first();
+    if (s) await ctx.db.patch(s._id, { syncedAt: now });
+    return { saved };
+  },
+});
+
+// ---------- Daily sync (10:00 America/Chicago) ----------
+
+export const syncState = internalQuery({
+  args: {},
+  handler: async (ctx): Promise<SyncStateResult> => {
+    const meta = await ctx.db.query("reelsApiSync").withIndex("by_name", q => q.eq("name", "daily")).first();
+    const states = await ctx.db.query("reelsApi").collect();
+    const out = [];
+    for (const s of states) {
+      const l = await ctx.db.get(s.listingId);
+      out.push({
+        listingId: s.listingId, propertyId: s.propertyId ?? null, archived: !!s.archived, address: s.address ?? null,
+        listing: l ? { address: l.address, live: LIVE.includes(l.status), hasLinks: REEL_PLATFORMS.some(p => linkOf(l, p)) } : null,
+      });
+    }
+    // Live listings with Reel links that the Reels service doesn't know yet (links pasted before this integration).
+    const known = new Set(states.filter(s => s.propertyId).map(s => s.listingId));
+    const missing = (await ctx.db.query("listings").collect())
+      .filter(l => !known.has(l._id) && LIVE.includes(l.status) && REEL_PLATFORMS.some(p => isReelFor(p, linkOf(l, p))))
+      .map(l => l._id);
+    return { lastSyncAt: meta?.lastSyncAt ?? null, states: out, missing };
+  },
+});
+
+export const setLastSync = internalMutation({
+  args: { at: v.number() },
+  handler: async (ctx, { at }) => {
+    const meta = await ctx.db.query("reelsApiSync").withIndex("by_name", q => q.eq("name", "daily")).first();
+    if (meta) await ctx.db.patch(meta._id, { lastSyncAt: at });
+    else await ctx.db.insert("reelsApiSync", { name: "daily", lastSyncAt: at });
+    return null;
+  },
+});
+
+/** Start a job without a signed-in agent (daily sync, ops, tests). */
+export const startJobInternal = internalMutation({
+  args: { listingId: v.id("listings"), by: v.string(), kind: v.optional(v.union(v.literal("links"), v.literal("refresh"))) },
+  handler: async (ctx, { listingId, by, kind }): Promise<{ since: number }> => ({ since: await startJob(ctx, listingId, kind ?? "links", by) }),
+});
+
+export const clearProperty = internalMutation({
+  args: { listingId: v.id("listings") },
+  handler: async (ctx, { listingId }) => {
+    const s = await ctx.db.query("reelsApi").withIndex("by_listing", q => q.eq("listingId", listingId)).first();
+    if (s) await ctx.db.delete(s._id);
+    return null;
+  },
+});
+
+const chicagoHour = (t: number) => Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Chicago", hour: "numeric", hourCycle: "h23" }).format(t));
+
+/** Cron at 15:00 and 16:00 UTC; runs only in the one that is 10:00 in Chicago (follows daylight saving). */
+export const dailySync = internalAction({
+  args: { force: v.optional(v.boolean()) },
+  handler: async (ctx, { force }): Promise<Record<string, unknown>> => {
+    const started = Date.now();
+    if (!force && chicagoHour(started) !== 10) return { skipped: "not 10:00 in Chicago" };
+    const st: SyncStateResult = await ctx.runQuery(internal.reelsApi.syncState, {});
+    const byProperty = new Map(st.states.filter(s => s.propertyId).map(s => [s.propertyId as string, s]));
+    const since = new Date(st.lastSyncAt ?? started - 48 * 3600_000).toISOString().replace(/\.\d{3}Z$/, "Z");
+    let items = 0;
+    let saved = 0;
+    let cursor: string | null = null;
+    for (let page = 0; page < 50; page++) {
+      const r: { data: { items: ApiAnalytics[]; next_cursor: string | null } } = await call("GET", "/analytics", { query: { updated_since: since, limit: "200", ...(cursor ? { cursor } : {}) } });
+      for (const it of r.data.items) {
+        items++;
+        const s = byProperty.get(it.property_id);
+        if (!s?.listing) continue;
+        const r2: { saved: number } = await ctx.runMutation(internal.reelsApi.applyAnalytics, { listingId: s.listingId, reels: it.reels });
+        saved += r2.saved;
+      }
+      cursor = r.data.next_cursor;
+      if (!cursor) break;
+    }
+    // Housekeeping: sold/withdrawn → archive; back on market → unarchive; deleted listing → delete; new address → PATCH.
+    const ops: string[] = [];
+    for (const s of st.states) {
+      if (!s.propertyId) continue;
+      try {
+        if (!s.listing) {
+          await call("DELETE", `/properties/${s.propertyId}`, { query: { hard: "true" } });
+          await ctx.runMutation(internal.reelsApi.clearProperty, { listingId: s.listingId });
+          ops.push(`delete ${s.propertyId}`);
+          continue;
+        }
+        if (!s.listing.live && !s.archived) {
+          await call("POST", `/properties/${s.propertyId}/archive`);
+          await patch(ctx, s.listingId, { archived: true });
+          ops.push(`archive ${s.propertyId}`);
+        } else if (s.listing.live && s.archived && s.listing.hasLinks) {
+          await call("POST", `/properties/${s.propertyId}/unarchive`);
+          await patch(ctx, s.listingId, { archived: false });
+          ops.push(`unarchive ${s.propertyId}`);
+        }
+        if (s.listing.address !== s.address) {
+          await call("PATCH", `/properties/${s.propertyId}`, { body: { address: s.listing.address } });
+          await patch(ctx, s.listingId, { address: s.listing.address });
+          ops.push(`address ${s.propertyId}`);
+        }
+      } catch (e) {
+        ops.push(`failed ${s.propertyId}: ${e instanceof Error ? e.message : e}`);
+      }
+    }
+    for (const id of st.missing.slice(0, 25)) {
+      await ctx.runMutation(internal.reelsApi.startJobInternal, { listingId: id, by: "daily" });
+      ops.push(`create ${id}`);
+    }
+    await ctx.runMutation(internal.reelsApi.setLastSync, { at: started });
+    console.log("reels api daily sync", JSON.stringify({ since, items, saved, ops }));
+    return { since, items, saved, ops };
+  },
+});
