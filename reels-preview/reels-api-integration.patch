+            <dt className="flex items-center justify-center gap-1 text-[11px] uppercase tracking-[0.1em] text-stone-500"><Icon className="size-3.5 text-[#9C7434]" aria-hidden />{label}</dt>
+            <dd className="mt-1 font-display text-2xl">{total(k) == null ? "–" : total(k)?.toLocaleString()}</dd>
+          </div>
+        ))}
+      </dl>
+
+      <div className="mt-5 grid gap-5 sm:grid-cols-[minmax(0,18rem)_minmax(0,1fr)]">
+        <div>
+          {cur.embedUrl ? (
+            <div className="mx-auto aspect-[9/16] w-full max-w-[20rem] overflow-hidden rounded-2xl bg-[#0A0A0A]">
+              <iframe key={cur.embedUrl} src={cur.embedUrl} title={`${REEL_LABEL[cur.platform]} Reel`} className="size-full border-0" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" allowFullScreen referrerPolicy="strict-origin-when-cross-origin" data-testid="seller-reel-player" />
+            </div>
+          ) : (
+            <a href={cur.url} target="_blank" rel="noreferrer" className="mx-auto grid aspect-[9/16] w-full max-w-[20rem] place-items-center rounded-2xl bg-[#0A0A0A] p-6 text-center text-white">
+              <span><span className="font-display text-lg">Watch on {REEL_LABEL[cur.platform]}</span><ArrowUpRight className="mx-auto mt-2 size-5 text-[#D9BC8C]" aria-hidden /></span>
+            </a>
+          )}
+        </div>
+
+        <ul className="space-y-2 self-start">
+          {reels.map(r => {
+            const on = r.platform === cur.platform;
+            return (
+              <li key={r.platform} data-testid={`seller-reel-${r.platform}`}>
+                <div className={`rounded-xl p-3 ring-1 transition ${on ? "bg-[#FBF7EF] ring-[#9C7434]" : "ring-stone-200"}`}>
+                  <div className="flex items-center justify-between gap-3">
+                    <button type="button" onClick={() => setSel(r.platform)} aria-pressed={on} className="min-w-0 text-left font-semibold">
+                      {REEL_LABEL[r.platform]}{on ? <span className="ml-2 text-xs font-medium text-[#7A5A25]">playing</span> : <span className="ml-2 text-xs font-medium text-stone-500 underline">watch here</span>}
+                    </button>
+                    <a href={r.url} target="_blank" rel="noreferrer" className="inline-flex shrink-0 items-center gap-0.5 text-sm text-stone-600">Open<ArrowUpRight className="size-4 text-[#9C7434]" aria-hidden /></a>
+                  </div>
+                  {r.checkedAt ? (
+                    <dl className="mt-2 grid grid-cols-4 gap-1 text-center">
+                      {METRICS.map(([k, label]) => (
+                        <div key={k}>
+                          <dd className={`font-display text-lg ${r[k] == null ? "text-stone-300" : ""}`} title={r[k]?.toLocaleString()}>{r[k] == null ? "–" : short(r[k] as number)}</dd>
+                          <dt className="text-[11px] text-stone-500">{label}</dt>
+                        </div>
+                      ))}
+                    </dl>
+                  ) : (
+                    <p className="mt-1 text-sm text-stone-500">Numbers show after the next morning update.</p>
+                  )}
+                </div>
+              </li>
+            );
+          })}
+        </ul>
+      </div>
+      <p className="mt-4 text-xs text-stone-500">Totals so far, read from each platform's public page every morning. A dash means that platform doesn't show the number publicly.</p>
+    </section>
+  );
+}
