+// Reel links → SpaceMatch Reels API (background job) → numbers on the agent card and the seller page.
+// Uses the dev demo listing "1620 N Hoyne Ave" (m571sp80…), which is linked to the Reels API test
+// property prop_cee1b388b2324f2fbb0a. Refresh now calls the real API (dev key), 1-3 minutes.
+import { runTest } from "./auth";
+
+const DEMO = "m571sp80ckh0dr3dd3ymcv0xfs8j180n";
+const SELLER = "6h7MBFhWAQTMjdJWJcurMhrg";
+const LINKS = {
+  Instagram: "https://www.instagram.com/reel/DTOz5t5jLQH/",
+  TikTok: "https://vt.tiktok.com/ZSpaGf8Yp/",
+};
+
+async function numbers(page: import("playwright").Page) {
+  const got: Record<string, string> = {};
+  for (const p of ["instagram", "facebook", "tiktok", "youtube"]) {
+    for (const k of ["views", "likes", "comments", "shares"]) {
+      const el = page.getByTestId(`reel-${p}-${k}`);
+      got[`${p}.${k}`] = (await el.count()) ? ((await el.textContent()) ?? "").trim() : "(no numbers)";
+    }
+  }
+  return got;
+}
+
+runTest("Reel stats: links, Reels API refresh, seller page", async helper => {
+  const { page } = helper;
+
+  // 1. A new listing: wrong box / wrong site are refused in the form; a video another listing has is refused by the Hub.
+  await helper.goto("/listings");
+  await page.getByRole("button", { name: /New listing/ }).first().click();
+  await page.getByPlaceholder("1234 N Main St, Chicago, IL 60614").fill("TEST 99 W Reel Dup St, Chicago, IL 60601");
+  await page.getByLabel(/Seller name/).fill("Riley Demo");
+  await page.getByRole("button", { name: "Create listing" }).click();
+  await page.getByText("Seller's live page").waitFor({ timeout: 15000 });
+  await page.getByRole("button", { name: "Weekly numbers" }).click();
+  let card = page.getByTestId("reel-links");
+  await card.waitFor({ timeout: 10000 });
+  await card.getByLabel("Instagram Reel link").fill(LINKS.TikTok);
+  await card.getByRole("button", { name: "Save Reel links" }).click();
+  await page.getByText(/Instagram: That is a TikTok link/).waitFor({ timeout: 5000 });
+  await card.getByLabel("Instagram Reel link").fill("https://example.com/reel/abc");
+  await card.getByRole("button", { name: "Save Reel links" }).click();
+  await page.getByText(/Only Instagram, Facebook, TikTok and YouTube links work here/).waitFor({ timeout: 5000 });
+  await card.getByLabel("Instagram Reel link").fill(`${LINKS.Instagram}?utm_source=test`);
+  await card.getByRole("button", { name: "Save Reel links" }).click();
+  await page.getByText(/Instagram: this video is already linked to .*Remove it there first/).waitFor({ timeout: 8000 });
+  await card.screenshot({ path: "screenshots/reel-stats-duplicate.png" });
+
+  // 2. The demo listing: numbers from the Reels API, N/A where a platform doesn't show a count.
+  await helper.goto(`/listings/${DEMO}`);
+  await page.getByRole("button", { name: "Weekly numbers" }).click();
+  card = page.getByTestId("reel-links");
+  await card.waitFor({ timeout: 10000 });
+  await page.getByTestId("reel-instagram-views").waitFor({ timeout: 10000 });
+  const before = await numbers(page);
+  console.log("AGENT NUMBERS BEFORE", JSON.stringify(before));
+  for (const k of ["tiktok.views", "facebook.views", "facebook.likes", "youtube.views", "instagram.views", "instagram.likes"]) {
+    if (!/^[\d,]+$/.test(before[k])) throw new Error(`${k} should be a number, got "${before[k]}"`);
+  }
+  if (before["instagram.shares"] !== "N/A" || before["youtube.shares"] !== "N/A") throw new Error("Shares should be N/A on Instagram/YouTube");
+  if (!(await card.getByText(/As of /).count())) throw new Error("Missing 'As of' time");
+
+  // 3. Refresh now → background job → "Refreshing…" → new numbers → 10-minute countdown.
+  const btn = page.getByTestId("reel-refresh");
+  if (await btn.isDisabled()) {
+    console.log("Refresh is cooling down:", await btn.textContent());
+  } else {
+    await btn.click();
+    await page.getByText(/Refreshing\. New numbers show here/).waitFor({ timeout: 8000 });
+    await page.getByTestId("reel-queued").waitFor({ timeout: 8000 });
+    if (!(await btn.isDisabled())) throw new Error("Refresh should be disabled while refreshing");
+    await card.screenshot({ path: "screenshots/reel-stats-agent-queued.png" });
+    const t0 = Date.now();
+    await page.getByTestId("reel-queued").waitFor({ state: "detached", timeout: 300000 });
+    console.log("REFRESH TOOK", Math.round((Date.now() - t0) / 1000), "s");
+    if (await page.getByTestId("reel-api-error").count()) throw new Error(`API error: ${await page.getByTestId("reel-api-error").textContent()}`);
+    await page.getByText(/Refresh in \d+:\d\d/).waitFor({ timeout: 8000 });
+    if (!(await btn.isDisabled())) throw new Error("Refresh should be disabled during the cooldown");
+  }
+  const after = await numbers(page);
+  console.log("AGENT NUMBERS AFTER", JSON.stringify(after));
+  await card.scrollIntoViewIfNeeded();
+  await card.screenshot({ path: "screenshots/reel-stats-agent.png" });
+
+  // 4. Seller page (public link, no login): the Reels play on the page with their numbers.
+  const origin = new URL(page.url()).origin;
+  for (const [name, vp] of [["mobile", { width: 390, height: 844 }], ["desktop", { width: 1100, height: 900 }]] as const) {
+    const ctx2 = await page.context().browser()!.newContext({ viewport: vp });
+    const sp = await ctx2.newPage();
+    await sp.goto(`${origin}/s/${SELLER}`);
+    const sec = sp.getByTestId("seller-reels");
+    await sec.waitFor({ timeout: 15000 });
+    for (const p of ["instagram", "facebook", "tiktok", "youtube"]) await sp.getByTestId(`seller-reel-${p}`).waitFor({ timeout: 5000 });
+    const totals = ((await sp.getByTestId("seller-reels-totals").textContent()) ?? "").replace(/\s+/g, " ");
+    console.log("SELLER TOTALS", name, totals);
+    if (!/Views[\d,]+/.test(totals)) throw new Error(`Seller totals missing views: ${totals}`);
+    await sp.getByTestId("seller-reel-player").waitFor({ timeout: 10000 });
+    await sec.scrollIntoViewIfNeeded();
+    await sp.waitForTimeout(12000); // let the embedded player draw
+    await sec.screenshot({ path: `screenshots/reel-stats-seller-${name}.png` });
+    await sp.getByTestId("seller-reel-youtube").getByRole("button").click();
+    await sp.waitForTimeout(4000);
+    if (!((await sp.getByTestId("seller-reel-player").getAttribute("src")) ?? "").startsWith("https://www.youtube.com/embed/")) throw new Error("Player did not switch to YouTube");
+    await ctx2.close();
+  }
+}).catch(() => process.exit(1));
